{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake debug",
            "type": "shell",
            "command" : "cmake --build --preset debug-gcc",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },

        {
            "label": "CMake release",
            "type": "shell",
            "command" : "cmake --build --preset release-gcc",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },

        {
            "label": "CMake relwithdebinfo",
            "type": "shell",
            "command" : "cmake --build --preset relwithdebinfo-gcc",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}